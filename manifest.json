{
  "manifest_version": 3,
  "name": "academiatechtools",
  "short_name": "academiatechtools",
  "version": "1.0",
  "description": "Provided by academiatechtools.com - Best Digital Tools Services.",
  "minimum_chrome_version": "88.0",
  "author": ".academiatechtools.com",
  "homepage_url": "https://academiatechtools.com",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "scripting",
    "storage",
    "activeTab",
    "tabs",
    "cookies"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "dynamic_rules",
        "enabled": true,
        "path": "dynamic_rules.json"
      }
    ]
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "externally_connectable": {
    "matches": [
      "*://*.academiatechtools.com/*"
    ]
  },
  "key": "",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "academiatechtools.com",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "all_frames": true,
      "js": [
        "jquery.js",
        "content.js",
        "nazi.js"
      ],
      "matches": [
        "*://*.academiatechtools.com/*",
        "*://academiatechtools.com/*"
      ],
      "run_at": "document_end"
    },
    {
      "matches": [
        "*://*/*"
      ],
      "js": [
        "content_all.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
